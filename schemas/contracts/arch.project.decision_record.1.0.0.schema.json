{
  "$id": "https://schemas.arch.local/arch.project.decision_record/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Historical decision retained as a superficially immutable record.",
  "properties": {
    "context": {
      "title": "Context",
      "type": "string"
    },
    "contract_name": {
      "title": "Contract Name",
      "type": "string"
    },
    "contract_version": {
      "examples": [
        "1.0.0",
        "1.2.3-alpha.1",
        "1.2.3-rc.1+sha.abc123"
      ],
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "title": "SemanticVersion",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decided_by": {
      "title": "Decided By",
      "type": "string"
    },
    "decision": {
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "examples": [
        "DEC-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
      ],
      "pattern": "^DEC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
      "title": "DecisionId",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "related_artifact_ids": {
      "items": {
        "examples": [
          "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
        ],
        "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
        "title": "ArtifactId",
        "type": "string"
      },
      "title": "Related Artifact Ids",
      "type": "array"
    },
    "related_requirement_ids": {
      "items": {
        "examples": [
          "REQ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
        ],
        "pattern": "^REQ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
        "title": "RequirementId",
        "type": "string"
      },
      "title": "Related Requirement Ids",
      "type": "array"
    },
    "schema_uri": {
      "title": "Schema Uri",
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "examples": [
            "DEC-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^DEC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "DecisionId",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "schema_uri",
    "created_at",
    "decision_id",
    "title",
    "context",
    "decision",
    "rationale",
    "status",
    "decided_by",
    "decided_at"
  ],
  "title": "DecisionRecord",
  "type": "object"
}

{
  "$defs": {
    "AnyCanonicalId": {
      "anyOf": [
        {
          "examples": [
            "PRJ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PRJ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ProjectId",
          "type": "string"
        },
        {
          "examples": [
            "PHX-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PHX-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PhaseExecutionId",
          "type": "string"
        },
        {
          "examples": [
            "PHS-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PHS-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PhaseId",
          "type": "string"
        },
        {
          "examples": [
            "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ArtifactId",
          "type": "string"
        },
        {
          "examples": [
            "REQ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^REQ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "RequirementId",
          "type": "string"
        },
        {
          "examples": [
            "GATE-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^GATE-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "GateId",
          "type": "string"
        },
        {
          "examples": [
            "GEX-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^GEX-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "GateExecutionId",
          "type": "string"
        },
        {
          "examples": [
            "APR-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^APR-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ApprovalId",
          "type": "string"
        },
        {
          "examples": [
            "CHG-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^CHG-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ChangeId",
          "type": "string"
        },
        {
          "examples": [
            "EVT-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^EVT-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "EventId",
          "type": "string"
        },
        {
          "examples": [
            "ASN-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ASN-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "AssignmentId",
          "type": "string"
        },
        {
          "examples": [
            "PATCH-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PATCH-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PatchId",
          "type": "string"
        },
        {
          "examples": [
            "DEC-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^DEC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "DecisionId",
          "type": "string"
        },
        {
          "examples": [
            "RISK-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^RISK-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "RiskId",
          "type": "string"
        },
        {
          "examples": [
            "TRN-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^TRN-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "TransitionId",
          "type": "string"
        },
        {
          "examples": [
            "INV-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^INV-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "InvariantId",
          "type": "string"
        },
        {
          "examples": [
            "MIG-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^MIG-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "MigrationId",
          "type": "string"
        },
        {
          "examples": [
            "WFL-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^WFL-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "WorkflowId",
          "type": "string"
        }
      ]
    },
    "TransitionDomain": {
      "description": "Closed domain names admitted by transition definitions.",
      "enum": [
        "project_lifecycle",
        "phase_status",
        "artifact_status",
        "approval_decision",
        "risk_status",
        "requirement_status",
        "workflow_state"
      ],
      "title": "TransitionDomain",
      "type": "string"
    },
    "TransitionTarget": {
      "additionalProperties": false,
      "description": "Typed target whose ID must agree with its transition domain.",
      "properties": {
        "domain": {
          "$ref": "#/$defs/TransitionDomain"
        },
        "entity_id": {
          "$ref": "#/$defs/AnyCanonicalId"
        }
      },
      "required": [
        "domain",
        "entity_id"
      ],
      "title": "TransitionTarget",
      "type": "object"
    }
  },
  "$id": "https://schemas.arch.local/arch.transition.transition_request/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable request to resolve and evaluate one declared transition.",
  "properties": {
    "base_state_record_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base State Record Version"
    },
    "expected_from_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected From State"
    },
    "expected_state_content_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected State Content Fingerprint"
    },
    "expected_target_content_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Target Content Fingerprint"
    },
    "expected_target_record_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Target Record Version"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array"
          },
          {
            "type": "object"
          }
        ]
      },
      "title": "FrozenJsonObject",
      "type": "object"
    },
    "project_id": {
      "examples": [
        "PRJ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
      ],
      "pattern": "^PRJ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
      "title": "ProjectId",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "examples": [
            "CHG-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^CHG-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ChangeId",
          "type": "string"
        },
        {
          "examples": [
            "PATCH-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PATCH-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PatchId",
          "type": "string"
        }
      ],
      "title": "Request Id"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/TransitionTarget"
    },
    "transition_id": {
      "anyOf": [
        {
          "examples": [
            "TRN-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^TRN-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "TransitionId",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transition Id"
    },
    "transition_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transition Key"
    }
  },
  "required": [
    "request_id",
    "project_id",
    "target",
    "requested_at"
  ],
  "title": "TransitionRequest",
  "type": "object"
}

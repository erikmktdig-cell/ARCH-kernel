{
  "$defs": {
    "AnyCanonicalId": {
      "anyOf": [
        {
          "examples": [
            "PRJ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PRJ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ProjectId",
          "type": "string"
        },
        {
          "examples": [
            "PHX-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PHX-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PhaseExecutionId",
          "type": "string"
        },
        {
          "examples": [
            "PHS-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PHS-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PhaseId",
          "type": "string"
        },
        {
          "examples": [
            "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ArtifactId",
          "type": "string"
        },
        {
          "examples": [
            "REQ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^REQ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "RequirementId",
          "type": "string"
        },
        {
          "examples": [
            "GATE-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^GATE-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "GateId",
          "type": "string"
        },
        {
          "examples": [
            "GEX-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^GEX-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "GateExecutionId",
          "type": "string"
        },
        {
          "examples": [
            "APR-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^APR-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ApprovalId",
          "type": "string"
        },
        {
          "examples": [
            "CHG-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^CHG-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ChangeId",
          "type": "string"
        },
        {
          "examples": [
            "EVT-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^EVT-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "EventId",
          "type": "string"
        },
        {
          "examples": [
            "ASN-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ASN-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "AssignmentId",
          "type": "string"
        },
        {
          "examples": [
            "PATCH-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PATCH-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PatchId",
          "type": "string"
        },
        {
          "examples": [
            "DEC-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^DEC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "DecisionId",
          "type": "string"
        },
        {
          "examples": [
            "RISK-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^RISK-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "RiskId",
          "type": "string"
        },
        {
          "examples": [
            "TRN-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^TRN-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "TransitionId",
          "type": "string"
        },
        {
          "examples": [
            "INV-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^INV-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "InvariantId",
          "type": "string"
        },
        {
          "examples": [
            "MIG-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^MIG-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "MigrationId",
          "type": "string"
        }
      ]
    },
    "ArtifactStatus": {
      "description": "Canonical artifact lifecycle status.",
      "enum": [
        "draft",
        "proposed",
        "under_review",
        "changes_requested",
        "conditionally_approved",
        "approved",
        "rejected",
        "invalidated",
        "superseded",
        "archived"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "Immutable reference to evidence content without fetching or verifying it.",
      "properties": {
        "content_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Ref"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_id": {
          "$ref": "#/$defs/AnyCanonicalId"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "version": {
          "anyOf": [
            {
              "examples": [
                "1.0.0",
                "1.2.3-alpha.1",
                "1.2.3-rc.1+sha.abc123"
              ],
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
              "title": "SemanticVersion",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type"
      ],
      "title": "EvidenceReference",
      "type": "object"
    }
  },
  "$id": "https://schemas.arch.local/arch.project.artifact_record/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned metadata and traceability information for an artifact.",
  "properties": {
    "artifact_id": {
      "examples": [
        "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
      ],
      "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "artifact_type": {
      "title": "Artifact Type",
      "type": "string"
    },
    "content_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Fingerprint"
    },
    "content_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Uri"
    },
    "contract_name": {
      "title": "Contract Name",
      "type": "string"
    },
    "contract_version": {
      "examples": [
        "1.0.0",
        "1.2.3-alpha.1",
        "1.2.3-rc.1+sha.abc123"
      ],
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "title": "SemanticVersion",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "title": "Owner",
      "type": "string"
    },
    "record_version": {
      "minimum": 1,
      "title": "Record Version",
      "type": "integer"
    },
    "schema_uri": {
      "title": "Schema Uri",
      "type": "string"
    },
    "state_version_created": {
      "minimum": 0,
      "title": "State Version Created",
      "type": "integer"
    },
    "state_version_updated": {
      "minimum": 0,
      "title": "State Version Updated",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ArtifactStatus"
    },
    "superseded_by": {
      "anyOf": [
        {
          "examples": [
            "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ArtifactId",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "supersedes": {
      "anyOf": [
        {
          "examples": [
            "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ArtifactId",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "version": {
      "examples": [
        "1.0.0",
        "1.2.3-alpha.1",
        "1.2.3-rc.1+sha.abc123"
      ],
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "title": "SemanticVersion",
      "type": "string"
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "schema_uri",
    "created_at",
    "record_version",
    "state_version_created",
    "state_version_updated",
    "artifact_id",
    "name",
    "artifact_type",
    "status",
    "owner",
    "version"
  ],
  "title": "ArtifactRecord",
  "type": "object"
}

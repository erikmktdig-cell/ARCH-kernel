          "type": "string"
        }
      ]
    },
    "TypedReference": {
      "additionalProperties": false,
      "description": "Immutable reference to another canonical object without resolving it.",
      "properties": {
        "relation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation"
        },
        "target_id": {
          "$ref": "#/$defs/AnyCanonicalId"
        },
        "target_type": {
          "title": "Target Type",
          "type": "string"
        },
        "target_version": {
          "anyOf": [
            {
              "examples": [
                "1.0.0",
                "1.2.3-alpha.1",
                "1.2.3-rc.1+sha.abc123"
              ],
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
              "title": "SemanticVersion",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Version"
        }
      },
      "required": [
        "target_type",
        "target_id"
      ],
      "title": "TypedReference",
      "type": "object"
    }
  },
  "$id": "https://schemas.arch.local/arch.project.dependency_edge/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Directed, immutable dependency relationship between two references.",
  "properties": {
    "contract_name": {
      "title": "Contract Name",
      "type": "string"
    },
    "contract_version": {
      "examples": [
        "1.0.0",
        "1.2.3-alpha.1",
        "1.2.3-rc.1+sha.abc123"
      ],
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "title": "SemanticVersion",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dependency_type": {
      "enum": [
        "requires",
        "produces",
        "blocks",
        "supersedes",
        "validates",
        "relates_to"
      ],
      "title": "Dependency Type",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "required": {
      "title": "Required",
      "type": "boolean"
    },
    "schema_uri": {
      "title": "Schema Uri",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/TypedReference"
    },
    "target": {
      "$ref": "#/$defs/TypedReference"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "schema_uri",
    "created_at",
    "source",
    "target",
    "dependency_type",
    "required"
  ],
  "title": "DependencyEdge",
  "type": "object"
}

{
  "$id": "https://schemas.arch.local/arch.project.project_metadata/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Human and system identifiers for a project aggregate.",
  "properties": {
    "contract_name": {
      "title": "Contract Name",
      "type": "string"
    },
    "contract_version": {
      "examples": [
        "1.0.0",
        "1.2.3-alpha.1",
        "1.2.3-rc.1+sha.abc123"
      ],
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "title": "SemanticVersion",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "title": "Owner",
      "type": "string"
    },
    "project_id": {
      "examples": [
        "PRJ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
      ],
      "pattern": "^PRJ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
      "title": "ProjectId",
      "type": "string"
    },
    "schema_uri": {
      "title": "Schema Uri",
      "type": "string"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "schema_uri",
    "created_at",
    "updated_at",
    "project_id",
    "name",
    "slug",
    "owner"
  ],
  "title": "ProjectMetadata",
  "type": "object"
}

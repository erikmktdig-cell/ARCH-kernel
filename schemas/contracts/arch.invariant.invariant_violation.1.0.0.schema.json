{
  "$defs": {
    "AnyCanonicalId": {
      "anyOf": [
        {
          "examples": [
            "PRJ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PRJ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ProjectId",
          "type": "string"
        },
        {
          "examples": [
            "PHX-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PHX-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PhaseExecutionId",
          "type": "string"
        },
        {
          "examples": [
            "PHS-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PHS-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PhaseId",
          "type": "string"
        },
        {
          "examples": [
            "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ArtifactId",
          "type": "string"
        },
        {
          "examples": [
            "REQ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^REQ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "RequirementId",
          "type": "string"
        },
        {
          "examples": [
            "GATE-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^GATE-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "GateId",
          "type": "string"
        },
        {
          "examples": [
            "GEX-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^GEX-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "GateExecutionId",
          "type": "string"
        },
        {
          "examples": [
            "APR-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^APR-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ApprovalId",
          "type": "string"
        },
        {
          "examples": [
            "CHG-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^CHG-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ChangeId",
          "type": "string"
        },
        {
          "examples": [
            "EVT-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^EVT-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "EventId",
          "type": "string"
        },
        {
          "examples": [
            "ASN-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ASN-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "AssignmentId",
          "type": "string"
        },
        {
          "examples": [
            "PATCH-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^PATCH-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "PatchId",
          "type": "string"
        },
        {
          "examples": [
            "DEC-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^DEC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "DecisionId",
          "type": "string"
        },
        {
          "examples": [
            "RISK-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^RISK-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "RiskId",
          "type": "string"
        },
        {
          "examples": [
            "TRN-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^TRN-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "TransitionId",
          "type": "string"
        },
        {
          "examples": [
            "INV-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^INV-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "InvariantId",
          "type": "string"
        },
        {
          "examples": [
            "MIG-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^MIG-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "MigrationId",
          "type": "string"
        }
      ]
    },
    "InvariantEvidence": {
      "additionalProperties": false,
      "description": "Stable evidence attached to one invariant violation.",
      "properties": {
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvariantJsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvariantJsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "InvariantEvidence",
      "type": "object"
    },
    "InvariantJsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "InvariantKind": {
      "description": "Closed canonical implementations supported by the K07 engine.",
      "enum": [
        "single_active_phase",
        "lifecycle_phase_alignment",
        "approved_baseline_integrity",
        "required_dependency_satisfaction",
        "requirement_traceability",
        "critical_risk_control",
        "terminal_phase_consistency",
        "immutable_history_consistency",
        "monotonic_record_versions"
      ],
      "title": "InvariantKind",
      "type": "string"
    },
    "InvariantScope": {
      "description": "Closed scopes available for deterministic invariant selection.",
      "enum": [
        "project",
        "lifecycle",
        "phase",
        "artifact",
        "requirement",
        "risk",
        "dependency",
        "history"
      ],
      "title": "InvariantScope",
      "type": "string"
    },
    "InvariantSeverity": {
      "description": "Policy severity, independent from diagnostic transport severity.",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "InvariantSeverity",
      "type": "string"
    },
    "TypedReference": {
      "additionalProperties": false,
      "description": "Immutable reference to another canonical object without resolving it.",
      "properties": {
        "relation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation"
        },
        "target_id": {
          "$ref": "#/$defs/AnyCanonicalId"
        },
        "target_type": {
          "title": "Target Type",
          "type": "string"
        },
        "target_version": {
          "anyOf": [
            {
              "examples": [
                "1.0.0",
                "1.2.3-alpha.1",
                "1.2.3-rc.1+sha.abc123"
              ],
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
              "title": "SemanticVersion",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Version"
        }
      },
      "required": [
        "target_type",
        "target_id"
      ],
      "title": "TypedReference",
      "type": "object"
    }
  },
  "$id": "https://schemas.arch.local/arch.invariant.invariant_violation/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One independently consumable invariant finding.",
  "properties": {
    "blocking": {
      "title": "Blocking",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/InvariantEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "invariant_id": {
      "examples": [
        "INV-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
      ],
      "pattern": "^INV-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
      "title": "InvariantId",
      "type": "string"
    },
    "key": {
      "title": "Key",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/InvariantKind"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "remediation_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remediation Hint"
    },
    "scope": {
      "$ref": "#/$defs/InvariantScope"
    },
    "severity": {
      "$ref": "#/$defs/InvariantSeverity"
    }
  },
  "required": [
    "invariant_id",
    "key",
    "kind",
    "scope",
    "severity",
    "blocking",
    "message",
    "evidence"
  ],
  "title": "InvariantViolation",
  "type": "object"
}

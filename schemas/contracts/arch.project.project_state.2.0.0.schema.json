    "ArtifactRecord": {
      "additionalProperties": false,
      "description": "Versioned metadata and traceability information for an artifact.",
      "properties": {
        "artifact_id": {
          "examples": [
            "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "ArtifactId",
          "type": "string"
        },
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "content_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Fingerprint"
        },
        "content_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Uri"
        },
        "contract_name": {
          "title": "Contract Name",
          "type": "string"
        },
        "contract_version": {
          "examples": [
            "1.0.0",
            "1.2.3-alpha.1",
            "1.2.3-rc.1+sha.abc123"
          ],
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
          "title": "SemanticVersion",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "record_version": {
          "minimum": 1,
          "title": "Record Version",
          "type": "integer"
        },
        "schema_uri": {
          "title": "Schema Uri",
          "type": "string"
        },
        "state_version_created": {
          "minimum": 0,
          "title": "State Version Created",
          "type": "integer"
        },
        "state_version_updated": {
          "minimum": 0,
          "title": "State Version Updated",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "superseded_by": {
          "anyOf": [
            {
              "examples": [
                "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
              ],
              "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
              "title": "ArtifactId",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "supersedes": {
          "anyOf": [
            {
              "examples": [
                "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
              ],
              "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
              "title": "ArtifactId",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "version": {
          "examples": [
            "1.0.0",
            "1.2.3-alpha.1",
            "1.2.3-rc.1+sha.abc123"
          ],
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
          "title": "SemanticVersion",
          "type": "string"
        }
      },
      "required": [
        "contract_name",
        "contract_version",
        "schema_uri",
        "created_at",
        "record_version",
        "state_version_created",
        "state_version_updated",
        "artifact_id",
        "name",
        "artifact_type",
        "status",
        "owner",
        "version"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "ArtifactStatus": {
      "description": "Canonical artifact lifecycle status.",
      "enum": [
        "draft",
        "proposed",
        "under_review",
        "changes_requested",
        "conditionally_approved",
        "approved",
        "rejected",
        "invalidated",
        "superseded",
        "archived"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "description": "Historical decision retained as a superficially immutable record.",
      "properties": {
        "context": {
          "title": "Context",
          "type": "string"
        },
        "contract_name": {
          "title": "Contract Name",
          "type": "string"
        },
        "contract_version": {
          "examples": [
            "1.0.0",
            "1.2.3-alpha.1",
            "1.2.3-rc.1+sha.abc123"
          ],
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
          "title": "SemanticVersion",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "title": "Decided By",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "decision_id": {
          "examples": [
            "DEC-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
          ],
          "pattern": "^DEC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
          "title": "DecisionId",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "related_artifact_ids": {
          "items": {
            "examples": [
              "ART-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
            ],
            "pattern": "^ART-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
            "title": "ArtifactId",
            "type": "string"
          },
          "title": "Related Artifact Ids",
          "type": "array"
        },
        "related_requirement_ids": {
          "items": {
            "examples": [
              "REQ-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
            ],
            "pattern": "^REQ-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
            "title": "RequirementId",
            "type": "string"
          },
          "title": "Related Requirement Ids",
          "type": "array"
        },
        "schema_uri": {
          "title": "Schema Uri",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "examples": [
                "DEC-01HZX7M3FQ1T2Q9V8Y6K4C2B1A"
              ],
              "pattern": "^DEC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{26}$",
              "title": "DecisionId",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "contract_name",
        "contract_version",
        "schema_uri",
        "created_at",
        "decision_id",
        "title",
        "context",
        "decision",
        "rationale",
        "status",
        "decided_by",
        "decided_at"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "DependencyEdge": {
      "additionalProperties": false,
      "description": "Directed, immutable dependency relationship between two references.",
      "properties": {
        "contract_name": {
          "title": "Contract Name",
          "type": "string"
        },
        "contract_version": {
          "examples": [
            "1.0.0",
            "1.2.3-alpha.1",
            "1.2.3-rc.1+sha.abc123"
          ],
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
          "title": "SemanticVersion",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dependency_type": {
          "enum": [
            "requires",
            "produces",
            "blocks",
            "supersedes",
            "validates",
            "relates_to"
          ],
          "title": "Dependency Type",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_uri": {
          "title": "Schema Uri",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/TypedReference"
        },
        "target": {
          "$ref": "#/$defs/TypedReference"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "contract_name",
        "contract_version",
        "schema_uri",
        "created_at",
        "source",
        "target",
        "dependency_type",
        "required"
      ],
      "title": "DependencyEdge",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "Immutable reference to evidence content without fetching or verifying it.",
